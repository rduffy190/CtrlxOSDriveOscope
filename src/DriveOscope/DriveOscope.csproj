<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DriveOscope</RootNamespace>
    <!-- Snap build output (build-snap-amd64.sh) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;snap/**;parts/**;stage/**;prime/**</DefaultItemExcludes>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <!-- Folder holding the netstandard2.0 build of EAL.dll / SiP.dll. Override with -p:EalBinDir=... -->
    <EalBinDir Condition="'$(EalBinDir)' == ''">/usr/local/eal_sdk/02VRS/eal4DotNetStandard20/bin</EalBinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ctrlX-DataLayer" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EAL">
      <HintPath>$(EalBinDir)/EAL.dll</HintPath>
    </Reference>
    <Reference Include="SiP">
      <HintPath>$(EalBinDir)/SiP.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="bfbs/*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
